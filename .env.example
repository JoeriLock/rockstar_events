SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

# Set to True to send a verification email on registration; False = manual admin approval
REQUIRE_EMAIL_VERIFICATION=False

# Email — leave EMAIL_HOST_USER unset for local dev (falls back to console backend)
# Gmail SMTP: use an App Password, not your normal Gmail password
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-16-char-app-password
# DEFAULT_FROM_EMAIL=you@gmail.com
